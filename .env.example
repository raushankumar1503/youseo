# AI provider configuration.
# Used only by the server-side generation endpoint. Never expose these to the client.

# --- Option A: local AI via Ollama (no API key required) ---
# Set OLLAMA_MODEL to enable the local provider. OLLAMA_BASE_URL is optional
# and defaults to http://localhost:11434. No AI_API_KEY needed for this path.
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# --- Option B: cloud OpenAI-compatible provider ---
# Only needed if you are NOT using Ollama. Leave AI_API_KEY empty to use the
# local Ollama provider above.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: override the API base URL for alternative OpenAI-compatible providers
# AI_BASE_URL=https://api.openai.com/v1